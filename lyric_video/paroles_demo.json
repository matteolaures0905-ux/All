  "text": "la *FAMILLE* avant tout le reste"
 },
 {
  "start": 20.4,
  "end": 24.1,
  "text": "pas de pause on reste concentrés"
 },
 {
  "start": 24.2,
  "end": 27.9,
  "text": "les étoiles brillent au-dessus du *BLOC*"
 },
 {
  "start": 28.0,
  "end": 31.7,
  "text": "on écrit notre histoire en *COULEUR*"
 },
 {
  "start": 31.8,
