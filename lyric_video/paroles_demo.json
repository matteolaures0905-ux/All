 },
 {
  "start": 39.4,
  "end": 43.1,
  "text": "chaque rime pèse comme de l'*OR*"
 },
 {
  "start": 43.2,
  "end": 46.9,
  "text": "on lâche rien même quand ça tangue"
 },
 {
  "start": 47.0,
  "end": 50.7,
  "text": "les vrais restent toujours *DEBOUT*"
 },
 {
  "start": 50.8,
  "end": 54.5,
