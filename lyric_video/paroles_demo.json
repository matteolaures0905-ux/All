  "text": "les nuits sont longues quand le cœur est en *FEU*"
 },
 {
  "start": 9.0,
  "end": 12.7,
  "text": "dans le quartier on rêve en grand"
 },
 {
  "start": 12.8,
  "end": 16.5,
  "text": "chaque jour on avance *ENSEMBLE*"
 },
 {
  "start": 16.6,
